# Neon PostgreSQL (production + recommended for local dev)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

JWT_SECRET="your-secret-key-change-in-production"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
NOMINATIM_USER_AGENT="GuruCRM/1.0 (your-contact@email.com)"
PORT=5001
HOST=0.0.0.0
# Include /guru-crm on GitHub Pages production
FRONTEND_URL="http://localhost:5173"

# Password reset email (pick one on production)

# Recommended on Render — https://resend.com
# RESEND_API_KEY="re_..."
# RESEND_FROM="Guru CRM <onboarding@resend.dev>"

# Alternative: Gmail SMTP (may hang from some cloud hosts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Guru CRM <your-email@gmail.com>"
