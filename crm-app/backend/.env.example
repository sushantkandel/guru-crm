# Neon PostgreSQL (production + recommended for local dev)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

JWT_SECRET="your-secret-key-change-in-production"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
NOMINATIM_USER_AGENT="SalesGuru/1.0 (your-contact@email.com)"
PORT=5001
HOST=0.0.0.0
# Include /guru-crm on GitHub Pages production
FRONTEND_URL="http://localhost:5173"

# Password reset — Brevo HTTP API (required on Render free tier; see BREVO_SETUP.md)
BREVO_API_KEY="xkeysib-your-api-key"
BREVO_FROM="Sales Guru <your-verified-sender@gmail.com>"

# Optional: Brevo SMTP (local dev only — blocked on Render free tier)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-brevo-login@email.com"
# SMTP_PASS="your-brevo-smtp-key"
# SMTP_FROM="Sales Guru <your-verified-sender@gmail.com>"
